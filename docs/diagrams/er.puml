@startuml
!pragma layout smetana
hide circle
skinparam linetype ortho

entity "Plans" as plan {
  * Id : TEXT <<PK>>
  --
  * Name : TEXT
  * OpeningCashKopecks : INTEGER
}

entity "MonthPlans" as month {
  * PlanId : TEXT <<PK, FK>>
  * MonthNumber : INTEGER (1..3) <<PK>>
  --
  * Quantity : INTEGER
  * PriceKopecks : INTEGER
  * UnitCostKopecks : INTEGER
  * FixedCostsKopecks : INTEGER
  * PaidNowPercent : INTEGER (0..100)
}

plan ||--|{ month : "содержит ровно 3\nON DELETE CASCADE"
@enduml
